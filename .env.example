# Application
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+psycopg://gpie:gpie@localhost:5432/gpie
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_DEFAULT_TIMEOUT=5
REDIS_MAX_CONNECTIONS=50

# LLM Providers
LLM_PROVIDER=openai  # Options: openai, anthropic, gemini, fallback
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30
OPENAI_MAX_RETRIES=3

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_TIMEOUT=30

GEMINI_API_KEY=...
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT=30

# Amazon Integration
AMAZON_ASSOCIATE_TAG=
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_REGION=US
AMAZON_ENABLED=false

# eBay Integration
EBAY_APP_ID=
EBAY_DEV_ID=
EBAY_CERT_ID=
EBAY_SERVER_URL=https://svcs.ebay.com
EBAY_ENABLED=false

# Outreach
OUTREACH_ENABLED=true
OUTREACH_PROVIDER=console  # Options: console, email, sms, webhook
OUTREACH_REQUIRE_PERMISSION=true

# Email (if using email outreach)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@gpie.local
SMTP_TLS=false

# Policy
POLICY_REQUIRE_AFFILIATE_DISCLOSURE=true
POLICY_ENFORCE_CONTACT_RULES=true
POLICY_MIN_INTENT_SCORE=0.6

# Tracking
TRACKING_ENABLED=true
TRACKING_BASE_URL=http://localhost:8000/track
TRACKING_EXPIRY_DAYS=90

# Worker Configuration
WORKER_INGESTION_ENABLED=true
WORKER_INGESTION_BATCH_SIZE=10
WORKER_INGESTION_INTERVAL_SECONDS=5

WORKER_CLASSIFICATION_ENABLED=true
WORKER_CLASSIFICATION_BATCH_SIZE=5
WORKER_CLASSIFICATION_INTERVAL_SECONDS=10

WORKER_OFFERS_ENABLED=true
WORKER_OFFERS_BATCH_SIZE=5
WORKER_OFFERS_INTERVAL_SECONDS=15

WORKER_OUTREACH_ENABLED=true
WORKER_OUTREACH_BATCH_SIZE=5
WORKER_OUTREACH_INTERVAL_SECONDS=20

WORKER_CONVERSION_ENABLED=true
WORKER_CONVERSION_BATCH_SIZE=5
WORKER_CONVERSION_INTERVAL_SECONDS=30

# Scheduler
SCHEDULER_ENABLED=true

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Observability
ENABLE_STRUCTURED_LOGGING=true
ENABLE_TRACING=false
ENABLE_METRICS=false
